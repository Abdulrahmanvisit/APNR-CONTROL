# Application Configuration
FLASK_APP=app.py
FLASK_ENV=production
FLASK_SECRET_KEY=change-this-to-a-secure-secret-key
FLASK_COOKIE_SECURE=1

# Tesseract OCR – use the Linux system path on Railway / Render
TESSERACT_CMD=/usr/bin/tesseract

# Admin Account Auto-Provisioning (MVP convenience)
# On first startup, if no users exist, an Admin account is created with these credentials.
# After first login, the app redirects to /account/reset-password to set a permanent password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeThisPassword123

# ------------------------------------------------------------------
# Database Configuration
#
# On Railway, link a MySQL service and these MYSQL_* variables (and
# DATABASE_URL) are provided automatically via the private network.
# DATABASE_URL, if set, takes precedence over the individual MYSQL_*
# variables.
#
# Local development (no DATABASE_URL):
#   APNR_DB_HOST, APNR_DB_PORT, APNR_DB_NAME, APNR_DB_USER, APNR_DB_PASSWORD
#
# The application resolves connection details in priority order:
#   1. DATABASE_URL  (e.g. mysql://user:pass@host:port/dbname)
#   2. MYSQL_*       (Railway MySQL plugin)
#   3. APNR_DB_*     (legacy / local development)
#   4. Sensible localhost defaults
# ------------------------------------------------------------------

# Railway / Render database variables (auto-injected by MySQL plugin)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=apnr_db
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
# DATABASE_URL=mysql://user:password@host:port/database

# Legacy variable names (still supported as a fallback if MYSQL_* are unset)
APNR_DB_HOST=127.0.0.1
APNR_DB_PORT=3306
APNR_DB_NAME=apnr_db
APNR_DB_USER=root
APNR_DB_PASSWORD=your_mysql_password_here

# Do not store application login passwords here. Provision users through:
# python manage_users.py <username> --role Admin|Supervisor|Operator|Auditor
