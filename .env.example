# Application Configuration
FLASK_APP=app.py
FLASK_ENV=production
FLASK_SECRET_KEY=change-this-to-a-secure-secret-key
FLASK_COOKIE_SECURE=1

# Tesseract OCR – use the Linux system path on Railway / Render
TESSERACT_CMD=/usr/bin/tesseract

# ------------------------------------------------------------------
# Database Configuration
#
# Local development (no DATABASE_URL):
#   APNR_DB_HOST, APNR_DB_PORT, APNR_DB_NAME, APNR_DB_USER, APNR_DB_PASSWORD
#
# Railway / Render (prefer these in that order):
#   DATABASE_URL=mysql://user:pass@host:port/dbname
#   MYSQL_HOST, MYSQL_USER, MYSQL_PASSWORD, MYSQL_DATABASE, MYSQL_PORT
# ------------------------------------------------------------------
APNR_DB_HOST=127.0.0.1
APNR_DB_PORT=3306
APNR_DB_NAME=apnr_db
APNR_DB_USER=root
APNR_DB_PASSWORD=your_mysql_password_here

# Do not store application login passwords here. Provision users through:
# python manage_users.py <username> --role Admin|Supervisor|Operator|Auditor
