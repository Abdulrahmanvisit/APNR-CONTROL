# Application Configuration
FLASK_APP=app.py
FLASK_ENV=production
FLASK_SECRET_KEY=change-this-to-a-secure-secret-key
FLASK_COOKIE_SECURE=1

# Tesseract OCR – use the Linux system path on Railway / Render
TESSERACT_CMD=/usr/bin/tesseract

# Admin Account Auto-Provisioning (MVP convenience)
# On first startup, if no users exist, an Admin account is created with these credentials.
# After first login, the app redirects to /account/reset-password to set a permanent password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeThisPassword123

# ------------------------------------------------------------------
# Database Configuration
#
# The application resolves connection details in priority order:
#   1. DATABASE_URL  (e.g. mysql://user:pass@host:port/dbname, postgres://..., sqlite:///path)
#   2. MYSQL_*       (Railway/Render MySQL plugin)
#   3. APNR_DB_*     (legacy / local development)
#   4. SQLite fallback (apnr_local.db in /tmp on Render, or app dir locally)
#   5. Sensible MySQL localhost defaults
#
# SQLite fallback is automatic: when no external database is reachable,
# the app uses a local SQLite file so login and admin provisioning still work.
# ------------------------------------------------------------------

# Keep-alive configuration (for UptimeRobot / Cron-job.org)
# Set to /api/v1/health on your uptime monitor to keep the service awake
# and database connections warm. The endpoint pings the database with SELECT 1.

# DATABASE_URL examples:
#   mysql://user:password@host:port/database
#   postgres://user:password@host:port/database
#   sqlite:///apnr_local.db
