# Application Configuration
FLASK_APP=app.py
FLASK_ENV=development
FLASK_SECRET_KEY=change-this-to-a-secure-secret-key
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Database Configuration
# On Railway, link a MySQL service and these MYSQL_* variables (and DATABASE_URL)
# are provided automatically via the private network. DATABASE_URL, if set,
# takes precedence over the individual MYSQL_* variables.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=apnr_db
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
# DATABASE_URL=mysql://user:password@host:port/database

# Legacy variable names (still supported as a fallback if MYSQL_* are unset)
APNR_DB_HOST=127.0.0.1
APNR_DB_PORT=3306
APNR_DB_NAME=apnr_db
APNR_DB_USER=root
APNR_DB_PASSWORD=your_mysql_password_here

# Do not store application login passwords here. Provision users through:
# python manage_users.py <username> --role Admin|Operator